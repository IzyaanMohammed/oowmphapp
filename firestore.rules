/**
 * @fileoverview Firestore Security Rules for MPH Booking Central.
 *
 * Core Philosophy:
 * This ruleset has been simplified to allow any authenticated user full access to manage session bookings.
 * The concept of user roles has been removed. All logged-in users are treated as teachers with equal permissions.
 *
 * Data Structure:
 * - /users/{userId}: Stores minimal user profile data. Access is restricted to the authenticated user matching {userId}.
 * - /sessionBookings/{bookingId}: Stores session booking information. Any authenticated user can create, read, update, and delete any booking.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages user profile data.
     * @path /users/{userId}
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      // Helper function to check if the user is signed in
      function isSignedIn() {
        return request.auth != null;
      }

      // Helper function to check if the requested user ID matches the authenticated user's ID.
      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      // Any authenticated user can read any profile.
      allow get: if isSignedIn();
      allow list: if isSignedIn(); 

      // Only the owner can create, update, or delete their own profile.
      allow write: if isOwner(userId);
    }

    /**
     * @description Manages session booking data, allowing full access for any authenticated user.
     * @path /sessionBookings/{bookingId}
     * @principle Any authenticated user has full control over all bookings.
     */
    match /sessionBookings/{bookingId} {
      // Allow public read and write access, since the app is protected by an access code.
      allow read, write: if true;
    }
  }
}
